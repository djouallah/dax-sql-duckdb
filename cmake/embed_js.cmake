# Embeds the JavaScript the extension runs, as it is in the tree: js/glue.js, dax-sql's src/ and
# its readers of TMSL, TMDL and Apache Ossie (formats/) at the submodule's commit, and the yaml
# parser the glue reads an Ossie .yaml with (third_party/yaml/dist). Each file is a byte array
# ending in a zero (QuickJS reads zero-terminated text), named by its module path: glue.js,
# dax-sql/src/..., dax-sql/formats/..., yaml/dist/...
function(dax_sql_embed_js output)
  set(dax_sql ${CMAKE_CURRENT_SOURCE_DIR}/third_party/dax-sql)
  file(
    GLOB_RECURSE compiler_files
    RELATIVE ${dax_sql}
    ${dax_sql}/src/*.js)
  list(SORT compiler_files)
  set(names glue.js)
  set(paths ${CMAKE_CURRENT_SOURCE_DIR}/js/glue.js)
  foreach(file ${compiler_files} formats/tmsl.js formats/tmdl.js formats/ossie.js
               formats/ossie-sql.js formats/model.js)
    list(APPEND names dax-sql/${file})
    list(APPEND paths ${dax_sql}/${file})
  endforeach()
  set(yaml ${CMAKE_CURRENT_SOURCE_DIR}/third_party/yaml)
  file(
    GLOB_RECURSE yaml_files
    RELATIVE ${yaml}
    ${yaml}/dist/*.js)
  list(SORT yaml_files)
  foreach(file ${yaml_files})
    list(APPEND names yaml/${file})
    list(APPEND paths ${yaml}/${file})
  endforeach()

  string(REPEAT "0x[0-9a-f][0-9a-f]," 16 row)
  set(arrays "")
  set(table "")
  list(LENGTH names count)
  math(EXPR last "${count} - 1")
  foreach(i RANGE ${last})
    list(GET names ${i} name)
    list(GET paths ${i} path)
    file(READ ${path} hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(${row})" "\\1\n" bytes "${bytes}")
    string(APPEND arrays
           "static const unsigned char module_${i}[] = {\n${bytes}0x00};\n")
    string(APPEND table "    {\"${name}\", module_${i}, ${size}},\n")
    set_property(
      DIRECTORY
      APPEND
      PROPERTY CMAKE_CONFIGURE_DEPENDS ${path})
  endforeach()

  file(
    WRITE ${output}
    "// Generated by cmake/embed_js.cmake: do not edit.\n"
    "#pragma once\n#include <cstddef>\n\nnamespace dax_sql_js {\n\n"
    "struct Module {\n  const char *name;\n  const unsigned char *data;\n"
    "  size_t size;\n};\n\n${arrays}\nstatic const Module MODULES[] = {\n"
    "${table}};\nstatic const size_t MODULE_COUNT = ${count};\n\n"
    "} // namespace dax_sql_js\n")
endfunction()
